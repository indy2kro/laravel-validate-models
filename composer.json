{
  "name": "indy2kro/laravel-validate-models",
  "description": "Validate Eloquent models against the database schema (columns, casts, fillables, relations).",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "eloquent",
    "validation",
    "models",
    "schema",
    "casts",
    "relations"
  ],
  "authors": [
    {
      "name": "Cristian Radu",
      "email": "indy2kro@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^1.2|^2",
    "friendsofphp/php-cs-fixer": "^3",
    "larastan/larastan": "^2|^3",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^1|^2",
    "phpunit/phpunit": "^10|^11|^12",
    "rector/rector": "^1|^2"
  },
  "autoload": {
    "psr-4": {
      "Indy2kro\\ValidateModels\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Indy2kro\\ValidateModels\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Indy2kro\\ValidateModels\\ValidateModelsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-clover build/coverage/clover.xml",
    "cs": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --dry-run --diff",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes",
    "stan": "phpstan analyse --ansi --memory-limit=1G",
    "rector": "rector process --dry-run",
    "rector:fix": "rector process",
    "quality": [
      "@cs",
      "@stan",
      "@rector",
      "@test"
    ],
    "ci": [
      "@quality"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
